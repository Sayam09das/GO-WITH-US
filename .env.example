NODE_ENV=development

# ── Database (local Docker: docker compose up -d postgres) ──
DATABASE_URL=postgresql://gowithus:gowithus@localhost:5432/gowithus?schema=public

# ── Redis (local Docker: docker compose up -d redis) ──
REDIS_URL=redis://localhost:6379

# ── Backend API (Express). Web SSR uses API_URL and appends /api/v1 when missing. ──
PORT=4000
HOST=0.0.0.0
API_URL=http://localhost:4000
APP_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
SESSION_SECRET=change-me-in-production-use-a-long-random-string
SESSION_COOKIE_NAME=gowithus_session

# ── Docker Compose (optional overrides) ──
# POSTGRES_USER=gowithus
# POSTGRES_PASSWORD=gowithus
# POSTGRES_DB=gowithus
# API_PORT=4000
# WEB_PORT=3000
# RUN_DB_MIGRATIONS=true

# ── Frontend (public — never put secrets here) ──
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Vercel (web only — set in Project → Environment Variables) ──
# Root Directory: apps/web (see apps/web/vercel.json). API/worker stay on Docker/GHCR/Render.
# API_URL=https://your-api.onrender.com
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
# On the API host: APP_ORIGIN / APP_URL must match NEXT_PUBLIC_SITE_URL for CORS + cookies.

# ── Optional: Supabase (avatars, travel documents) — see apps/api/.env.example ──
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# SUPABASE_SECRET_KEY=your-supabase-secret-key

# ── Optional: SMTP (worker email jobs) ──
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# MAIL_FROM=GoWithUs <noreply@example.com>
