NODE_ENV=development


# Database (local Docker)
DATABASE_URL=postgresql://gowithus:gowithus@localhost:5432/gowithus?schema=public

# Redis (local Docker)
REDIS_URL=redis://localhost:6379

# Backend API (Express). Web SSR also reads API_URL and appends /api/v1 when missing.
PORT=4000
API_URL=http://localhost:4000
APP_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
SESSION_SECRET=change-me-in-production
SESSION_COOKIE_NAME=gowithus_session

# Frontend (public — never put secrets here)
# Use same-origin proxy in dev so session cookies work on localhost:3000 (see apps/web/next.config.ts rewrites).
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
