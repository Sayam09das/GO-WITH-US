# Frontend Web Environment Variables Example
# Copy to apps/web/.env or apps/web/.env.local (do NOT commit .env or .env.local)

# Backend API URL (Express API on Render)
API_URL=https://go-with-us-5jyq.onrender.com

# Public API URL for client-side fetches
NEXT_PUBLIC_API_URL=https://go-with-us-5jyq.onrender.com/api/v1

# Public Site URL (Next.js Frontend on Vercel)
NEXT_PUBLIC_SITE_URL=https://go-with-us-web.vercel.app
APP_URL=https://go-with-us-web.vercel.app
