# Frontend Web Environment Variables Example
# Copy to apps/web/.env or apps/web/.env.local (do NOT commit .env or .env.local)

# Backend API URL (Express API on Render in production, localhost in dev)
API_URL=http://localhost:4000

# Public API URL for client-side fetches
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Public Site URL (Next.js Frontend on Vercel in production, localhost in dev)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_URL=http://localhost:3000
