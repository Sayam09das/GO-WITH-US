# Frontend Web Environment Variables Example
# Copy to apps/web/.env.local for local dev (do NOT commit .env or .env.local).
# On Vercel: Project → Settings → Environment Variables (Production + Preview).

# ── Local development ─────────────────────────────────────────────────────────
# Same-origin /api/v1 rewrites to API_URL (see apps/web/next.config.ts) so
# HttpOnly session cookies work on http://localhost:3000.

API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Vercel production checklist (apps/web root directory) ─────────────────────
# Required for SEO (sitemap, Open Graph, canonical URLs) and SSR API rewrites.
#
# API_URL=https://go-with-us-5jyq.onrender.com
# NEXT_PUBLIC_API_URL=/api/v1
# NEXT_PUBLIC_SITE_URL=https://go-with-us-web.vercel.app
#
# Do not use localhost values on Vercel. Redeploy after changing env vars.
#
# Mirror on Render (API service) for CORS + session cookies:
# APP_ORIGIN=https://go-with-us-web.vercel.app
# APP_URL=https://go-with-us-web.vercel.app
# API_URL=https://go-with-us-5jyq.onrender.com
