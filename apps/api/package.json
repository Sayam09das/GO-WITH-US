{
  "name": "@gowithus/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "pnpm --filter @gowithus/types build && pnpm --filter @gowithus/utils build && prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:destinations": "tsx prisma/seed-destinations-only.ts",
    "db:repair-catalog": "prisma db execute --file prisma/scripts/repair-catalog-columns.sql",
    "db:repair-trips": "prisma db execute --file prisma/scripts/repair-trips-schema.sql",
    "db:repair-documents": "prisma db execute --file prisma/scripts/repair-travel-documents.sql",
    "db:repair-profile": "prisma db execute --file prisma/scripts/repair-user-profile-preferences.sql",
    "db:repair-schema": "pnpm db:repair-catalog && pnpm db:repair-trips && pnpm db:repair-documents && pnpm db:repair-profile",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@gowithus/jobs": "workspace:*",
    "@gowithus/utils": "workspace:*",
    "@gowithus/types": "workspace:*",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@supabase/supabase-js": "^2.117.2",
    "argon2": "^0.43.0",
    "bullmq": "^5.56.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "multer": "^2.4.0",
    "nodemailer": "^7.0.3",
    "pg": "^8.16.0",
    "rate-limit-redis": "^4.2.1",
    "zod": "^3.25.36"
  },
  "devDependencies": {
    "@gowithus/config": "workspace:*",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.15.21",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.15.2",
    "prisma": "^7.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
