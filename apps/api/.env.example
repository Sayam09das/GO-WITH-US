# Environment variables example for GO WITH US API
# Copy to apps/api/.env — never commit .env or .env.local

# Server Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
SESSION_SECRET=gowithus_dev_session_secret_change_in_production_32bytes_min
SESSION_COOKIE_NAME=gowithus_session
SESSION_DURATION_DAYS=7
SESSION_REMEMBER_DURATION_DAYS=30

# PostgreSQL (local Docker or Supabase — see root docker-compose.yml)
DATABASE_URL=postgresql://gowithus:gowithus@localhost:5432/gowithus?schema=public
DIRECT_URL=postgresql://gowithus:gowithus@localhost:5432/gowithus?schema=public

# Redis (local Docker — see root docker-compose.yml)
# Optional in production: omit REDIS_URL on Render if you skip Redis; API runs degraded without it.
REDIS_URL=redis://localhost:6379

# Supabase Configuration (optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_AVATARS_BUCKET=avatars
SUPABASE_DOCUMENTS_BUCKET=travel-documents

# SMTP Configuration (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
MAIL_FROM=GoWithUs <noreply@example.com>

# Payment webhook verification (production)
PAYMENT_WEBHOOK_SECRET=your-payment-webhook-secret
