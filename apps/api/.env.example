# Environment variables example for GO WITH US API
# Copy to apps/api/.env — never commit .env or .env.local

# Server Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
SESSION_SECRET=gowithus_dev_session_secret_change_in_production_32bytes_min
SESSION_COOKIE_NAME=gowithus_session
SESSION_DURATION_DAYS=7
SESSION_REMEMBER_DURATION_DAYS=30

# PostgreSQL (local Docker — see root docker-compose.yml)
DATABASE_URL=

# Redis (local Docker — see root docker-compose.yml)
REDIS_URL=

# Supabase Configuration (optional)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# SMTP Configuration (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Payment webhook verification (production)
PAYMENT_WEBHOOK_SECRET=

# External travel providers (optional — leave blank or set to none)
PLACES_PROVIDER=
FOURSQUARE_API_KEY=
FOURSQUARE_API_URL=https://api.foursquare.com/v3

ACCOMMODATION_PROVIDER=
BOOKING_API_KEY=
BOOKING_API_URL=https://booking-com.p.rapidapi.com

EXPERIENCE_PROVIDER=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_API_URL=https://test.api.amadeus.com

# Provider HTTP client (optional)
PROVIDER_HTTP_TIMEOUT_MS=8000
PROVIDER_HTTP_MAX_RETRIES=1
