# Environment variables example for GO WITH US API

# Server Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_ORIGIN=http://localhost:3000
SESSION_SECRET=gowithus_dev_session_secret_change_in_production_32bytes_min

# PostgreSQL (local Docker — see root docker-compose.yml)
DATABASE_URL=postgresql://gowithus:gowithus@localhost:5432/gowithus?schema=public

# Supabase Configuration (optional — for future auth integration)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_secret_key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# SMTP Configuration (optional)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
MAIL_FROM="GoWithUs <noreply@example.com>"
