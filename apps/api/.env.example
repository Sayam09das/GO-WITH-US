# Environment variables example for GO WITH US API

# Server Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
SESSION_SECRET=gowithus_dev_session_secret_change_in_production_32bytes_min
SESSION_COOKIE_NAME=gowithus_session
SESSION_DURATION_DAYS=7
SESSION_REMEMBER_DURATION_DAYS=30

# PostgreSQL (local Docker — see root docker-compose.yml)
DATABASE_URL=postgresql://gowithus:gowithus@localhost:5432/gowithus?schema=public

# Redis (local Docker — see root docker-compose.yml)
REDIS_URL=redis://localhost:6379

# Supabase Configuration (optional — for future auth integration)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_secret_key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# SMTP Configuration (optional)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
MAIL_FROM="GoWithUs <noreply@example.com>"

# Payment webhook verification (production)
PAYMENT_WEBHOOK_SECRET=change_me_in_production

# External travel providers (optional — defaults to none/no-op)
PROVIDER_PLACES=none
PROVIDER_ACCOMMODATION=none
PROVIDER_EXPERIENCES=none

# Foursquare Places API (when PROVIDER_PLACES=foursquare)
FOURSQUARE_API_KEY=
FOURSQUARE_API_URL=https://api.foursquare.com/v3

# Booking.com accommodation API (when PROVIDER_ACCOMMODATION=booking)
BOOKING_API_KEY=
BOOKING_API_URL=https://booking-com.p.rapidapi.com

# Amadeus experiences API (when PROVIDER_EXPERIENCES=amadeus)
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
AMADEUS_API_URL=https://test.api.amadeus.com
