// GO WITH US database schema — canonical models for Step 3.
// Tutorial mappings: Profile → User fields, TripDay/TripItem → ItineraryItem,
// SavedDestination/SavedStay → SavedItem. Booking and Story are out of MVP scope.
// See docs/BACKEND_SETUP.md and docs/DATABASE.md §11.

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum BudgetTier {
  budget
  moderate
  luxury
}

enum PropertyType {
  boutique_hotel @map("boutique-hotel")
  villa
  apartment
  eco_lodge      @map("eco-lodge")
  lodge
}

enum ExperienceCategory {
  tours
  outdoor
  cultural
  food_dining @map("food-dining")
  attractions
}

enum ItemType {
  destination
  stay
  experience
  restaurant
  place
}

enum PlaceCategory {
  museum
  beach
  park
  market
  viewpoint
  temple
  historic_site      @map("historic-site")
  neighborhood
  gallery
  natural_attraction @map("natural-attraction")
}

enum ReviewStatus {
  pending
  published
  hidden
}

enum ReviewReportReason {
  spam                      @map("spam")
  inappropriate_content     @map("inappropriate_content")
  harassment
  false_information         @map("false_information")
  other
}

enum StoryCategory {
  editorial
  guides
  journeys
  tips
  inspiration
}

enum StoryStatus {
  draft
  published
  archived
}

enum ProviderSyncStatus {
  ACTIVE
  STALE
  FAILED
}

enum BookingType {
  stay
  experience
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  completed
  expired
}

enum PaymentStatus {
  unpaid
  pending
  paid
  failed
  refunded
}

enum PaymentProvider {
  stripe
  manual
}

enum ItineraryItemType {
  destination
  stay
  experience
  restaurant
  place
  custom
}

enum TimeSlot {
  morning
  afternoon
  evening
}

enum TripStatus {
  draft
  upcoming
  active
  completed
  cancelled
}

enum TravelDocumentCategory {
  bookings
  flights
  stays
  experiences
  invoices
  other
}

enum NotificationType {
  trip_reminder   @map("trip_reminder")
  itinerary_alert @map("itinerary_alert")
  system
}

enum UserRole {
  USER
  ADMIN
}

enum SecurityEventType {
  REGISTER
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  LOGOUT_ALL
  EMAIL_VERIFIED
  EMAIL_VERIFICATION_SENT
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_CHANGED
  SESSION_REVOKED
}

enum UserActivityType {
  SAVED_DESTINATION
  UNSAVED_DESTINATION
  SAVED_STAY
  UNSAVED_STAY
  SAVED_EXPERIENCE
  UNSAVED_EXPERIENCE
  SAVED_RESTAURANT
  UNSAVED_RESTAURANT
  CREATED_TRIP
  COMPLETED_PROFILE
  BOOKED_STAY
  BOOKED_EXPERIENCE
}

model User {
  id               String      @id @default(uuid()) @db.Uuid
  email            String      @unique @db.Citext
  passwordHash     String      @map("password_hash")
  fullName         String      @map("full_name")
  emailVerified    Boolean     @default(false) @map("email_verified")
  role             UserRole    @default(USER)
  avatarUrl        String?     @map("avatar_url")
  bio              String?
  phone            String?
  country          String?
  timezone         String?
  homeCity         String?     @map("home_city")
  travelStyles        String[]    @map("travel_styles")
  budgetPreference    BudgetTier? @map("budget_preference")
  profilePreferences  Json?       @map("profile_preferences")
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  savedItems              SavedItem[]
  trips                   Trip[]
  bookings                Booking[]
  reviews                 Review[]
  reviewReports           ReviewReport[]
  notifications           Notification[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  sessions                Session[]
  securityEvents          SecurityEvent[]
  activities              UserActivity[]
  travelDocuments         UserTravelDocument[]

  @@map("users")
}

model Destination {
  id              String     @id @default(uuid()) @db.Uuid
  slug            String     @unique
  title           String
  country         String
  region          String
  heroImage       String     @map("hero_image")
  gallery         String[]
  overview        String
  highlights      String[]
  climateNotes    String?    @map("climate_notes")
  currency        String?
  primaryLanguage String?    @map("primary_language")
  transportTips   String?    @map("transport_tips")
  budgetTier      BudgetTier @map("budget_tier")
  bestTimeToVisit String?    @map("best_time_to_visit")
  categoryTags    String[]   @map("category_tags")
  travelStyles    String[]   @map("travel_styles")
  ratingAvg       Decimal?   @map("rating_avg") @db.Decimal(3, 2)
  reviewCount     Int        @default(0) @map("review_count")
  isFeatured      Boolean    @default(false) @map("is_featured")
  isPublished     Boolean    @default(true) @map("is_published")
  city            String?
  latitude        Decimal?   @db.Decimal(10, 7)
  longitude       Decimal?   @db.Decimal(10, 7)
  provider        String?
  providerPlaceId String?    @map("provider_place_id")
  providerSyncedAt DateTime? @map("provider_synced_at") @db.Timestamptz(6)
  syncStatus      ProviderSyncStatus? @default(ACTIVE) @map("sync_status")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  stays        Stay[]
  experiences  Experience[]
  restaurants  Restaurant[]
  places       Place[]
  trips        Trip[]

  @@unique([provider, providerPlaceId])
  @@index([providerPlaceId])
  @@index([isPublished, isFeatured])
  @@map("destinations")
}

model Stay {
  id                   String       @id @default(uuid()) @db.Uuid
  destinationId        String       @map("destination_id") @db.Uuid
  slug                 String       @unique
  title                String
  propertyType         PropertyType @map("property_type")
  locationLabel        String       @map("location_label")
  heroImage            String       @map("hero_image")
  gallery              String[]
  overview             String
  amenities            String[]
  priceTier            BudgetTier   @map("price_tier")
  estimatedNightlyFrom Int?         @map("estimated_nightly_from")
  ratingAvg            Decimal?     @map("rating_avg") @db.Decimal(3, 2)
  reviewCount          Int          @default(0) @map("review_count")
  isFeatured           Boolean      @default(false) @map("is_featured")
  isPublished          Boolean      @default(true) @map("is_published")
  latitude             Decimal?     @db.Decimal(10, 7)
  longitude            Decimal?     @db.Decimal(10, 7)
  provider             String?
  providerPropertyId   String?      @map("provider_property_id")
  providerSyncedAt     DateTime?    @map("provider_synced_at") @db.Timestamptz(6)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  destination Destination @relation(fields: [destinationId], references: [id])

  @@unique([provider, providerPropertyId])
  @@index([providerPropertyId])
  @@index([destinationId, isPublished])
  @@map("stays")
}

model Experience {
  id                 String             @id @default(uuid()) @db.Uuid
  destinationId      String             @map("destination_id") @db.Uuid
  slug               String             @unique
  title              String
  category           ExperienceCategory
  durationLabel      String?            @map("duration_label")
  durationMinutes    Int?               @map("duration_minutes")
  meetingPoint       String?            @map("meeting_point")
  heroImage          String             @map("hero_image")
  gallery            String[]
  overview           String
  highlights         String[]
  included           String[]           @default([])
  requirements       String[]           @default([])
  cancellationPolicy String?            @map("cancellation_policy")
  priceTier          BudgetTier         @map("price_tier")
  estimatedPriceFrom Int?               @map("estimated_price_from")
  ratingAvg          Decimal?           @map("rating_avg") @db.Decimal(3, 2)
  reviewCount        Int                @default(0) @map("review_count")
  isFeatured         Boolean            @default(false) @map("is_featured")
  isPublished        Boolean            @default(true) @map("is_published")
  latitude           Decimal?           @db.Decimal(10, 7)
  longitude          Decimal?           @db.Decimal(10, 7)
  provider           String?
  providerPlaceId    String?            @map("provider_place_id")
  providerSyncedAt   DateTime?          @map("provider_synced_at") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  destination Destination @relation(fields: [destinationId], references: [id])

  @@unique([provider, providerPlaceId])
  @@index([providerPlaceId])
  @@index([destinationId, isPublished])
  @@map("experiences")
}

model Restaurant {
  id              String   @id @default(uuid()) @db.Uuid
  destinationId   String   @map("destination_id") @db.Uuid
  slug            String   @unique
  title           String
  cuisine         String
  heroImage       String   @map("hero_image")
  gallery         String[]
  overview        String
  priceLevel      Int      @map("price_level") @db.SmallInt
  address         String?
  latitude        Decimal? @db.Decimal(10, 7)
  longitude       Decimal? @db.Decimal(10, 7)
  openingHours    Json?    @map("opening_hours")
  menuHighlights  String[] @map("menu_highlights")
  amenities       String[] @default([])
  ratingAvg       Decimal? @map("rating_avg") @db.Decimal(3, 2)
  reviewCount     Int      @default(0) @map("review_count")
  isFeatured      Boolean  @default(false) @map("is_featured")
  isPublished     Boolean  @default(true) @map("is_published")
  provider        String?
  providerPlaceId String?  @map("provider_place_id")
  providerSyncedAt DateTime? @map("provider_synced_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  destination Destination @relation(fields: [destinationId], references: [id])

  @@unique([provider, providerPlaceId])
  @@index([providerPlaceId])
  @@index([destinationId, isPublished])
  @@map("restaurants")
}

model Place {
  id            String        @id @default(uuid()) @db.Uuid
  destinationId String        @map("destination_id") @db.Uuid
  slug          String        @unique
  title         String
  category      PlaceCategory
  locationLabel String?       @map("location_label")
  heroImage     String        @map("hero_image")
  gallery       String[]
  overview      String
  categoryTags  String[]      @map("category_tags")
  latitude      Decimal?      @db.Decimal(10, 7)
  longitude     Decimal?      @db.Decimal(10, 7)
  ratingAvg     Decimal?      @map("rating_avg") @db.Decimal(3, 2)
  reviewCount   Int           @default(0) @map("review_count")
  isFeatured    Boolean       @default(false) @map("is_featured")
  isPublished   Boolean       @default(true) @map("is_published")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  destination Destination @relation(fields: [destinationId], references: [id])

  @@index([destinationId, isPublished])
  @@map("places")
}

model SavedItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  itemType  ItemType @map("item_type")
  itemId    String   @map("item_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("saved_items")
}

model Trip {
  id            String     @id @default(uuid()) @db.Uuid
  userId        String     @map("user_id") @db.Uuid
  title         String
  destinationId String?    @map("destination_id") @db.Uuid
  startDate     DateTime?  @map("start_date") @db.Date
  endDate       DateTime?  @map("end_date") @db.Date
  description   String?
  coverImage    String?    @map("cover_image")
  status        TripStatus @default(draft)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination     Destination?     @relation(fields: [destinationId], references: [id])
  tripDays        TripDay[]
  itineraryItems  ItineraryItem[]
  notifications   Notification[]
  travelDocuments UserTravelDocument[]

  @@index([userId, status, startDate])
  @@map("trips")
}

model TripDay {
  id        String    @id @default(uuid()) @db.Uuid
  tripId    String    @map("trip_id") @db.Uuid
  dayIndex  Int       @map("day_index")
  dayDate   DateTime? @map("day_date") @db.Date
  title     String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, dayIndex])
  @@index([tripId, dayIndex])
  @@map("trip_days")
}

model ItineraryItem {
  id               String            @id @default(uuid()) @db.Uuid
  tripId           String            @map("trip_id") @db.Uuid
  dayIndex         Int               @map("day_index")
  dayDate          DateTime?         @map("day_date") @db.Date
  timeSlot         TimeSlot          @map("time_slot")
  scheduledTime    DateTime?         @map("scheduled_time") @db.Time(6)
  scheduledEndTime DateTime?         @map("scheduled_end_time") @db.Time(6)
  sortOrder        Int               @map("sort_order")
  itemType         ItineraryItemType @map("item_type")
  itemId           String?           @map("item_id") @db.Uuid
  title            String
  notes            String?
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, dayIndex, sortOrder])
  @@map("itinerary_items")
}

model UserTravelDocument {
  id          String                 @id @default(uuid()) @db.Uuid
  userId      String                 @map("user_id") @db.Uuid
  tripId      String?                @map("trip_id") @db.Uuid
  name        String
  category    TravelDocumentCategory @default(other)
  storagePath String                 @map("storage_path")
  publicUrl   String                 @map("public_url")
  mimeType    String                 @map("mime_type")
  sizeBytes   Int                    @map("size_bytes")
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip Trip? @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, category])
  @@map("user_travel_documents")
}

model Review {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  itemType  ItemType     @map("item_type")
  itemId    String       @map("item_id") @db.Uuid
  rating    Int          @db.SmallInt
  title     String?
  body      String?
  status    ReviewStatus @default(published)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports ReviewReport[]

  @@unique([userId, itemType, itemId])
  @@index([itemType, itemId, createdAt(sort: Desc)])
  @@index([itemType, itemId, status, createdAt(sort: Desc)])
  @@map("reviews")
}

model ReviewReport {
  id        String             @id @default(uuid()) @db.Uuid
  reviewId  String             @map("review_id") @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  reason    ReviewReportReason
  details   String?
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([reviewId, createdAt(sort: Desc)])
  @@map("review_reports")
}

model Story {
  id              String        @id @default(uuid()) @db.Uuid
  slug            String        @unique
  title           String
  excerpt         String
  content         String
  category        StoryCategory
  coverImage      String        @map("cover_image")
  authorName      String        @map("author_name")
  readTimeMinutes Int           @map("read_time_minutes")
  isFeatured      Boolean       @default(false) @map("is_featured")
  status          StoryStatus   @default(draft)
  publishedAt     DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, isFeatured, publishedAt(sort: Desc)])
  @@index([category, status, publishedAt(sort: Desc)])
  @@map("stories")
}

model Booking {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  bookingReference String        @unique @map("booking_reference")
  type             BookingType
  status           BookingStatus @default(pending)
  paymentStatus    PaymentStatus @default(unpaid) @map("payment_status")
  startDate        DateTime?     @map("start_date") @db.Date
  endDate          DateTime?     @map("end_date") @db.Date
  guestCount       Int           @default(1) @map("guest_count")
  totalAmount      Int           @map("total_amount")
  currency         String        @default("USD")
  idempotencyKey   String?       @unique @map("idempotency_key")
  cancellationNote String?       @map("cancellation_note")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items    BookingItem[]
  payments Payment[]

  @@index([userId, status, startDate])
  @@map("bookings")
}

model BookingItem {
  id            String       @id @default(uuid()) @db.Uuid
  bookingId     String       @map("booking_id") @db.Uuid
  stayId        String?      @map("stay_id") @db.Uuid
  experienceId  String?      @map("experience_id") @db.Uuid
  roomId        String?      @map("room_id")
  roomLabel     String?      @map("room_label")
  checkIn       DateTime?    @map("check_in") @db.Date
  checkOut      DateTime?    @map("check_out") @db.Date
  experienceDate DateTime?   @map("experience_date") @db.Date
  startTime     DateTime?    @map("start_time") @db.Time(6)
  guests        Json
  unitPrice     Int          @map("unit_price")
  totalPrice    Int          @map("total_price")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_items")
}

model Payment {
  id                String          @id @default(uuid()) @db.Uuid
  bookingId         String          @map("booking_id") @db.Uuid
  provider          PaymentProvider
  providerPaymentId String?         @map("provider_payment_id")
  amount            Int
  currency          String          @default("USD")
  status            PaymentStatus   @default(pending)
  idempotencyKey    String?         @unique @map("idempotency_key")
  metadata          Json?
  paidAt            DateTime?       @map("paid_at") @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, status])
  @@map("payments")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  body      String
  tripId    String?          @map("trip_id") @db.Uuid
  readAt    DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip Trip? @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, revokedAt])
  @@map("sessions")
}

model SecurityEvent {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String?           @map("user_id") @db.Uuid
  type      SecurityEventType
  ipAddress String?           @map("ip_address")
  userAgent String?           @map("user_agent")
  metadata  Json?
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
  @@map("security_events")
}

model UserActivity {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      UserActivityType
  title     String
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

